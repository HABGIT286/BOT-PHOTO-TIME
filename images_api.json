{
  "enabled": true,

  "provider": "miswag",

  "api": {
    "url": "https://miswag.com/api/v1/search",
    "method": "POST",
    "timeout": 30
  },

  "queries": [
    "الجمال والعناية",
    "العناية بالبشرة",
    "العناية بالشعر",
    "العطور",
    "المكياج",
    "الهواتف",
    "الالكترونيات",
    "الأجهزة المنزلية",
    "الألعاب",
    "الإكسسوارات"
  ],

  "request": {
    "page": 1,
    "per_page": 24
  },

  "response": {
    "products_path": "data.hits",
    "id": "id",
    "title": "title.AR",
    "image": "image",
    "price": "price.value",
    "currency": "price.currency",
    "brand": "brand",
    "url": "url"
  },

  "cache": {
    "enabled": true,
    "save_products": true,
    "avoid_duplicates": true,
    "max_products": 1000,
    "refresh_minutes": 30
  },

  "game": {
    "rounds": 3,
    "products_per_round": 3,
    "register_time": 30,
    "min_players": 2,
    "one_answer_only": true,
    "allow_answer_change": false,
    "allow_join_after_register": false,
    "allow_vote_after_end": false
  },

  "session": {
    "persistent": true,
    "restore_after_restart": true,
    "save_file": "sessions.json"
  }
}
