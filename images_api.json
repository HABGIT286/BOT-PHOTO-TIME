      }
    },

    {
      "name": "drinks",
      "query": "المشروبات",
      "payload": {
        "query": "المشروبات",
        "activeFilters": {},
        "page": 1,
        "perPage": 24
      }
    }
  ],

  "response": {
    "success_field": "success",

    "products_path": [
      "data",
      "hits"
    ],

    "fields": {
      "title": [
        "title",
        "AR"
      ],
      "price": [
        "price",
        "value"
      ],
      "currency": [
        "price",
        "currency"
      ],
      "brand": [
        "brand"
      ],
      "image": [
        "image"
      ],
      "url": [
        "url"
      ]
    }
  },

  "product_rules": {
    "require_title": true,
    "require_image": true,
    "require_price": true,
    "require_url": true,

    "allow_missing_brand": true,

    "allow_repeated_product_in_same_game": false,
    "allow_repeated_image_in_same_game": false,

    "avoid_duplicate_products": true,
    "avoid_duplicate_images": true
  },

  "cache": {
    "enabled": true,
    "max_products": 1000,
    "refresh_when_empty": true,
    "shuffle_products": true
  },

  "game": {
    "rounds": 3,
    "images_per_round": 3,
    "total_images": 9,

    "different_product_every_image": true,
    "different_image_every_image": true,

    "reset_used_products_when_new_game_starts": true,
    "reset_used_images_when_new_game_starts": true
  },

  "price": {
    "enabled": true,
    "currency_from_api": true,
    "default_currency": "IQD",

    "minimum": 0,
    "maximum": 10000000
  },

  "logging": {
    "enabled": true,
    "log_api_errors": true,
    "log_product_fetch": true,
    "log_invalid_products": true
  }
}
