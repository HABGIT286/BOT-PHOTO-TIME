{
  "bot_name": "Price Guess Pro",
  "version": "2.0.0",

  "owner_system": {
    "owner_from_env": true,
    "env_owner_id": "OWNER_USER_ID"
  },

  "discord": {
    "prefix": "!",
    "slash_commands": true,
    "prefix_commands": true,
    "sync_commands_on_start": true
  },

  "game": {
    "enabled": true,
    "allow_one_game_per_server": true,

    "register_time_seconds": 20,
    "guess_time_seconds": 20,

    "minimum_players": 2,

    "rounds_count": 3,
    "images_per_round": 5,

    "total_images_per_game": 15,

    "allow_join_after_register_close": false,
    "allow_leave_after_register_close": false,

    "disable_buttons_after_register_close": true,

    "cancel_if_less_than_two_players": true,

    "auto_next_image_when_all_answered": true,

    "auto_finish_game_after_last_image": true
  },

  "difficulty": {
    "easy": {
      "enabled": true,
      "name": "Easy"
    },

    "normal": {
      "enabled": true,
      "name": "Normal"
    },

    "hard": {
      "enabled": true,
      "name": "Hard"
    }
  },

  "points": {
    "first": 10,
    "second": 7,
    "third": 5,
    "fourth": 3,
    "others": 1,
    "no_answer": 0
  },

  "answers": {
    "numbers_only": true,
    "one_answer_per_player": true,
    "allow_answer_edit": false,
    "allow_answer_replace": false,
    "allow_second_answer": false,
    "reject_duplicate_answer_attempts": true
  },

  "security": {
    "anti_spam": true,
    "anti_multi_answer": true,
    "anti_edit_answer": true,
    "anti_late_join": true,
    "anti_late_leave": true,
    "anti_game_duplicate": true,
    "anti_button_abuse": true
  },

  "database": {
    "enabled": true,
    "file": "price_guess.db",

    "tables": [
      "players",
      "games",
      "rounds",
      "answers",
      "servers"
    ]
  },

  "logs": {
    "enabled": true,
    "folder": "logs",

    "save_game_start": true,
    "save_game_end": true,
    "save_answers": true,
    "save_points": true,
    "save_winners": true,
    "save_players": true
  },

  "profile": {
    "enabled": true
  },

  "leaderboard": {
    "enabled": true,
    "top_count": 10
  },

  "stats": {
    "enabled": true
  },

  "help": {
    "enabled": true
  },

  "commands": {
    "slash": [
      "game",
      "stop",
      "profile",
      "top",
      "stats",
      "help"
    ],

    "prefix": [
      "!game",
      "!stop",
      "!profile",
      "!top",
      "!stats",
      "!help"
    ]
  },

  "storage": {
    "servers_file": "servers.json",
    "products_file": "data/products_cache.json"
  },

  "miswag": {
    "enabled": true,

    "api_url": "https://miswag.com/api/v1/search",

    "timeout": 30,

    "per_page": 24,

    "query_rotation": [
      "الجمال والعناية",
      "المكياج",
      "العطور",
      "الكريمات",
      "الشامبو",
      "الحلاقة",
      "العناية بالبشرة",
      "المنتجات المنزلية",
      "الأغذية",
      "المشروبات"
    ],

    "avoid_duplicate_products": true,

    "avoid_duplicate_images": true,

    "require_image": true,

    "require_price": true,

    "require_title": true,

    "require_product_url": false,

    "cache_products": true,

    "refresh_when_empty": true,

    "random_product": true
  }
}
